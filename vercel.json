{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/admin/:path*",
      "missing": [
        {
          "type": "host",
          "value": "admin.visualizeclients.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/work/:slug",
      "destination": "/clients/:slug",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/clients",
      "permanent": true
    },
    {
      "source": "/prints",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/prints/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/call-leads",
      "destination": "/api/admin/index?r=call-leads"
    },
    {
      "source": "/api/admin/leads/import",
      "destination": "/api/admin/index?r=leads-import"
    },
    {
      "source": "/api/admin/submissions",
      "destination": "/api/admin/index?r=submissions"
    },
    {
      "source": "/api/admin/posts",
      "destination": "/api/admin/index?r=posts"
    },
    {
      "source": "/api/admin/projects",
      "destination": "/api/admin/index?r=projects"
    },
    {
      "source": "/api/admin/orders",
      "destination": "/api/admin/index?r=orders"
    },
    {
      "source": "/api/admin/concept-packs",
      "destination": "/api/admin/index?r=concept-packs"
    },
    {
      "source": "/api/admin/settings",
      "destination": "/api/admin/index?r=settings"
    },
    {
      "source": "/api/admin/calendly/events",
      "destination": "/api/admin/index?r=calendly-events"
    },
    {
      "source": "/api/admin/stripe/events",
      "destination": "/api/admin/index?r=stripe-events"
    },
    {
      "source": "/api/admin/stripe/reconcile",
      "destination": "/api/admin/index?r=stripe-reconcile"
    },
    {
      "source": "/api/admin/backup",
      "destination": "/api/admin/index?r=backup"
    },
    {
      "source": "/api/admin/export",
      "destination": "/api/admin/index?r=export"
    },
    {
      "source": "/api/admin/push-subscribe",
      "destination": "/api/admin/index?r=push-subscribe"
    },
    {
      "source": "/api/admin/log",
      "destination": "/api/admin/index?r=log"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.visualizeclients.com"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-9uN1hzbuLSc9N5ujLBMLrF+PrGFvTk99SmDqmupg0fY='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://api.cloudinary.com; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/clients/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 6 * * *"
    }
  ]
}
